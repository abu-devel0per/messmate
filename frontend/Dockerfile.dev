# Frontend Development Dockerfile
# Usage: docker build -f Dockerfile.dev -t messmate-frontend-dev ./frontend

FROM node:20-alpine

# Install system dependencies for Expo/React Native
RUN apk add --no-cache \
    bash \
    git \
    openssh-client \
    python3 \
    make \
    g++ \
    libc6-compat

# Install global tools
RUN npm install -g \
    expo-cli@latest \
    eas-cli@latest \
    yarn@1.22.22

# Create app directory
WORKDIR /app

# Set environment
ENV NODE_ENV=development
ENV EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
ENV REACT_NATIVE_PACKAGER_HOSTNAME=0.0.0.0

# Expose ports
EXPOSE 8081 19000 19001 19002

# Default command
CMD ["npx", "expo", "start", "--dev-client", "--host", "lan"]